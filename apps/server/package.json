{
  "name": "@agentworld/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative AgentWorld API and durable worker",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "auth:invite": "node dist/create-invite.js",
    "auth:invite:dev": "node --env-file-if-exists=../../.env --import tsx src/create-invite.ts",
    "db:migrate": "node dist/migrate.js",
    "db:migrate:dev": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts",
    "db:seed": "node dist/seed.js",
    "db:seed:dev": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/api.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --root ../.. apps/server",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@agentworld/api-contract": "workspace:*",
    "@agentworld/db": "workspace:*",
    "@agentworld/game-rules": "workspace:*",
    "@better-auth/oauth-provider": "1.7.2",
    "@prometheus-io/client": "0.16.1",
    "@sinclair/typebox": "0.34.52",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "better-auth": "1.7.2",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "kysely": "0.29.5",
    "nodemailer": "9.1.1",
    "uuid": "14.0.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.1",
    "tsx": "4.20.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
