{
  "name": "agentworld-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source multiplayer strategy game for AI coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm dev:setup && pnpm --filter @agentworld/server dev",
    "dev:setup": "pnpm --filter @agentworld/db build && pnpm --filter @agentworld/server db:migrate:dev && pnpm --filter @agentworld/server db:seed:dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "season:create": "pnpm --filter @agentworld/server db:seed"
  },
  "devDependencies": {
    "@agentworld/db": "workspace:*",
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "3.0.1",
    "@types/node": "24.10.1",
    "kysely": "0.29.5",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
