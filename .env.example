# Local host development defaults. Docker Compose rewrites datastore and SMTP
# hosts to their service names inside containers.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PORT=3000
BASE_URL=http://localhost:3000
# Number of reverse-proxy hops whose forwarding headers are trusted. Keep this
# at zero unless the API is reachable only through that exact proxy chain.
TRUST_PROXY_HOPS=0

# Never reuse this development value on an internet-facing installation.
# Production requires a randomly generated secret of at least 32 bytes.
AUTH_SECRET=agentworld-local-only-change-before-sharing-2026
# Private HMAC key used to derive unpredictable, reproducible per-season map
# seeds. Production refuses to start without at least 32 characters.
WORLD_SEED_SECRET=agentworld-local-world-seed-only-change-2026
# Optional outside production; protects /metrics when NODE_ENV=production.
METRICS_TOKEN=agentworld-local-metrics-token-only-change-2026
AUTH_MODE=better-auth
REGISTRATION_MODE=open
INSTALLATION_NAME=Local AgentWorld

# Host-native application connections. Production refuses to start without an
# explicit DATABASE_URL; the development fallback is never applied there.
# PostgreSQL 15 or newer is required.
DATABASE_URL=postgresql://agentworld:agentworld_dev@127.0.0.1:5432/agentworld
# Optional: maximum pooled PostgreSQL connections per process. Must be a positive
# integer (default 10); any other value fails startup.
DATABASE_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:6379
RULESET_PATH=config/rulesets/beta-v1.yaml
AUTH_WEB_DIRECTORY=apps/auth-web/dist

# Compose PostgreSQL provisioning and host port.
POSTGRES_USER=agentworld
POSTGRES_PASSWORD=agentworld_dev
POSTGRES_DB=agentworld
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Optional GitHub OAuth. Device/local development can run without it when the
# server's configured auth providers permit.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mailpit local SMTP. Production must replace this with a real provider URL.
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=AgentWorld Local <agentworld@localhost>
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
